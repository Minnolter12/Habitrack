<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing Liquid Wave & Flame Emblem -->

    <!-- Outer Glow Flame Layer -->
    <path
        android:pathData="M54,26 C43,38 38,50 38,62 C38,73 45,82 54,82 C63,82 70,73 70,62 C70,50 65,38 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="26"
                android:endX="54"
                android:endY="82">
                <item android:offset="0.0" android:color="#FF00E5FF" />
                <item android:offset="0.5" android:color="#FFE040FB" />
                <item android:offset="1.0" android:color="#FF7C4DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core Flame -->
    <path
        android:pathData="M54,38 C48,46 44,54 44,62 C44,69 48,74 54,74 C60,74 64,69 64,62 C64,54 60,46 54,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="38"
                android:endX="54"
                android:endY="74">
                <item android:offset="0.0" android:color="#FFFFD54F" />
                <item android:offset="0.6" android:color="#FFFF6D00" />
                <item android:offset="1.0" android:color="#FFE040FB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized 'H' Monogram Crossbar -->
    <path
        android:pathData="M32,54 L76,54"
        android:strokeWidth="4.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Left Pillar of 'H' -->
    <path
        android:pathData="M38,36 L38,72"
        android:strokeWidth="5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Right Pillar of 'H' -->
    <path
        android:pathData="M70,36 L70,72"
        android:strokeWidth="5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Center Liquid Sparkle Accent -->
    <path
        android:pathData="M54,48 L56,54 L54,60 L52,54 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
